FROM node:24-bookworm

# root 操作必须全部放在降权之前（apt / npm -g 都要求 root）
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && git config --system --add safe.directory '*'

RUN wget -q -O /tmp/chrome.deb https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb \
    && apt-get update \
    && apt-get install -y --no-install-recommends /tmp/chrome.deb \
    && rm -f /tmp/chrome.deb \
    && rm -rf /var/lib/apt/lists/* \
    && google-chrome --version

RUN apt-get update \
    && apt-get install -y --no-install-recommends fonts-noto-cjk fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*

# pnpm：容器里跑 skill 安装 / 项目依赖时要用，corepack 在部分 node 镜像里已移除，直接全局装
RUN npm install -g pnpm@latest \
    && pnpm --version

# pi-web：直接装构建上下文里的 tgz（依赖会照常从 registry 装）
# CI 用 npm pack 产出；本地构建先跑一句 npm pack --pack-destination docker/packages
COPY packages/*.tgz /tmp/pkg/
RUN npm install -g /tmp/pkg/*.tgz \
    && rm -rf /tmp/pkg

ENV PI_WEB_HOSTNAME=0.0.0.0 \
    PI_WEB_NO_OPEN=1

WORKDIR /workspace
EXPOSE 30141
