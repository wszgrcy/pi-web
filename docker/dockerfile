ARG XVFB_IMAGE=ghcr.io/linuxserver/selkies-layers:ubunturesolute-xvfb

FROM ${XVFB_IMAGE} AS xvfb

FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates curl wget unzip zip xz-utils \
    && rm -rf /var/lib/apt/lists/*

ARG FNM_VERSION=1.39.0
RUN curl -fsSL -o /tmp/fnm.zip \
      "https://github.com/Schniz/fnm/releases/download/v${FNM_VERSION}/fnm-linux.zip" \
    && unzip -o /tmp/fnm.zip -d /usr/local/bin \
    && chmod +x /usr/local/bin/fnm \
    && rm /tmp/fnm.zip \
    && fnm --version

ENV FNM_DIR=/opt/fnm
ARG NODE_VERSION=24.22.0
ENV PATH="/opt/node-default/bin:${PATH}"
RUN fnm install "${NODE_VERSION}" \
    && fnm default "${NODE_VERSION}" \
    && ln -sfn "${FNM_DIR}/node-versions/v${NODE_VERSION}/installation" /opt/node-default \
    && node -v \
    && npm -v

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       mesa-vulkan-drivers vulkan-tools libvulkan1 \
       libgl1 libegl1 libglx0 libgl1-mesa-dri libegl-mesa0 libglx-mesa0 libgomp1 \
       libx11-6 libxext6 libxfixes3 libxi6 libxrender1 libxrandr2 libxinerama1 \
       libxcursor1 libxxf86vm1 libsm6 libxkbcommon0 libxkbcommon-x11-0 \
       libdrm2 libgbm1 libasound2t64 libpulse0 libdbus-1-3 libudev1 \
       libxfont2 libaudit1 libepoxy0 libpixman-1-0 libxshmfence1 \
       xvfb x11vnc novnc websockify x11-utils openbox \
       openssh-server openssh-client \
       python3 python3-venv python3-pip python-is-python3 git procps \
       fonts-dejavu-core fonts-liberation \
    && rm -rf /var/lib/apt/lists/* \
    && git config --system --add safe.directory '*' \
    && mkdir -p /run/sshd \
    && ssh-keygen -A \
    && python -V && python3 -V && pip -V

COPY --from=xvfb / /
RUN ldd /usr/bin/Xvfb | tee /tmp/ldd.txt \
    && ! grep -q "not found" /tmp/ldd.txt \
    && /usr/bin/Xvfb -help 2>&1 | grep -q -- '-glamor' \
    && /usr/bin/Xvfb -help 2>&1 | grep -q -- '-dri'

ADD https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb /tmp/chrome.deb
RUN apt-get update \
    && apt-get install -y --no-install-recommends /tmp/chrome.deb \
    && rm -f /tmp/chrome.deb \
    && rm -rf /var/lib/apt/lists/* \
    && google-chrome --version

RUN apt-get update \
    && apt-get install -y --no-install-recommends fonts-noto-cjk fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*

# pnpm：容器里跑 skill 安装 / 项目依赖时要用，corepack 在部分 node 镜像里已移除，直接全局装
RUN npm install -g pnpm@latest \
    && pnpm --version

ARG UV_VERSION=0.13.3
RUN curl -fsSL -o /tmp/uv-install.sh "https://astral.sh/uv/${UV_VERSION}/install.sh" \
    && UV_INSTALL_DIR=/usr/local/bin UV_NO_MODIFY_PATH=1 sh /tmp/uv-install.sh \
    && rm -f /tmp/uv-install.sh \
    && uv --version \
    && uvx --version

ENV UV_LINK_MODE=copy

# pi-web：直接装构建上下文里的 tgz（依赖会照常从 registry 装）
# CI 用 npm pack 产出；本地构建先跑 npm pack --pack-destination docker/packages
COPY packages/*.tgz /tmp/pkg/
RUN npm install -g /tmp/pkg/*.tgz \
    && rm -rf /tmp/pkg

ENV PI_WEB_HOSTNAME=0.0.0.0 \
    PI_WEB_NO_OPEN=1 \
    DISPLAY=:1

WORKDIR /workspace
EXPOSE 30141 22 5900 6080
