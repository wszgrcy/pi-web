ARG XVFB_IMAGE=ghcr.io/linuxserver/selkies-layers:ubunturesolute-xvfb

FROM ${XVFB_IMAGE} AS xvfb

FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates curl wget unzip zip xz-utils \
    && rm -rf /var/lib/apt/lists/*

ARG FNM_VERSION=1.39.0
RUN curl -fsSL -o /tmp/fnm.zip \
      "https://github.com/Schniz/fnm/releases/download/v${FNM_VERSION}/fnm-linux.zip" \
    && unzip -o /tmp/fnm.zip -d /usr/local/bin \
    && chmod +x /usr/local/bin/fnm \
    && rm /tmp/fnm.zip \
    && fnm --version

ENV FNM_DIR=/opt/fnm
ARG NODE_VERSION=24.22.0
ENV PATH="/opt/node-default/bin:${PATH}"
RUN fnm install "${NODE_VERSION}" \
    && fnm default "${NODE_VERSION}" \
    && ln -sfn "${FNM_DIR}/node-versions/v${NODE_VERSION}/installation" /opt/node-default \
    && node -v \
    && npm -v
RUN sed -i 's|^PATH="|PATH="/opt/node-default/bin:|' /etc/environment \
    && [ "$(grep -c '^PATH=' /etc/environment)" = "1" ] \
    && grep -q '^PATH="/opt/node-default/bin:' /etc/environment
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       mesa-vulkan-drivers vulkan-tools libvulkan1 \
       libgl1 libegl1 libglx0 libgl1-mesa-dri libegl-mesa0 libglx-mesa0 libgomp1 \
       libx11-6 libxext6 libxfixes3 libxi6 libxrender1 libxrandr2 libxinerama1 \
       libxcursor1 libxxf86vm1 libsm6 libxkbcommon0 libxkbcommon-x11-0 \
       libdrm2 libgbm1 libasound2t64 libpulse0 libdbus-1-3 libudev1 \
       libxfont2 libaudit1 libepoxy0 libpixman-1-0 libxshmfence1 \
       xvfb x11vnc novnc websockify x11-utils xdotool openbox \
       openssh-server openssh-client \
       python3 python3-venv python3-pip python-is-python3 git procps \
       fonts-dejavu-core fonts-liberation \
    && rm -rf /var/lib/apt/lists/* \
    && git config --system --add safe.directory '*' \
    && mkdir -p /run/sshd \
    && ssh-keygen -A \
    && python -V && python3 -V && pip -V

COPY --from=xvfb / /
RUN ldd /usr/bin/Xvfb | tee /tmp/ldd.txt \
    && ! grep -q "not found" /tmp/ldd.txt \
    && /usr/bin/Xvfb -help 2>&1 | grep -q -- '-glamor' \
    && /usr/bin/Xvfb -help 2>&1 | grep -q -- '-dri'


RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       libnss3 libnspr4 libatk1.0-0t64 libatk-bridge2.0-0t64 libcups2t64 \
       libxcomposite1 libxdamage1 libxres1 libatspi2.0-0t64 \
       libcairo2 libpango-1.0-0 libglib2.0-0t64 libfontconfig1 libfreetype6 \
       libharfbuzz0b libfribidi0 libthai0 libdatrie1 libgraphite2-3 \
       libavahi-client3 libavahi-common3 \
       libgnutls30t64 libnettle8t64 libhogweed6t64 libidn2-0 libunistring5 \
       libtasn1-6 libp11-kit0 libkrb5-3 libgssapi-krb5-2 libk5crypto3 \
       libkeyutils1 libkrb5support0 libcom-err2 libselinux1 libmount1 libblkid1 \
       libsystemd0 libatomic1 libexpat1 libffi8 libgmp10 libbrotli1 libbz2-1.0 \
       libpng16-16t64 libpcre2-8-0 libxcb1 libxcb-render0 libxcb-shm0 \
       libxau6 libxdmcp6 libzstd1 zlib1g libgcc-s1 \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       fonts-noto-cjk fonts-noto-color-emoji \
       fonts-crosextra-carlito fonts-crosextra-caladea fonts-liberation2 \
    && rm -rf /var/lib/apt/lists/*


RUN test "$(fc-list | grep -ciE 'carlito|caladea')" -ge 2 \
    && echo "[fonts] Windows 度量兼容字体就位: $(fc-list | grep -oiE 'Carlito|Caladea' | sort -u | tr '\n' ' ')"

RUN apt-get update && apt-get install -y --no-install-recommends \
    libsecret-1-0 libsecret-common \
    libpython3-dev python3-dev \
    p7zip-full \
    && rm -rf /var/lib/apt/lists/*
# pnpm：容器里跑 skill 安装 / 项目依赖时要用，corepack 在部分 node 镜像里已移除，直接全局装
RUN npm install -g pnpm@latest \
    && pnpm --version

ARG UV_VERSION=0.13.3
RUN curl -fsSL -o /tmp/uv-install.sh "https://astral.sh/uv/${UV_VERSION}/install.sh" \
    && UV_INSTALL_DIR=/usr/local/bin UV_NO_MODIFY_PATH=1 sh /tmp/uv-install.sh \
    && rm -f /tmp/uv-install.sh \
    && uv --version \
    && uvx --version

ENV UV_LINK_MODE=copy


ARG PI_WEB_VERSION=latest
RUN npm install -g "@agegr/pi-web@${PI_WEB_VERSION}" \
    && npm ls -g --depth=0 @agegr/pi-web

ENV PI_WEB_HOSTNAME=0.0.0.0 \
    PI_WEB_NO_OPEN=1 \
    DISPLAY=:1

WORKDIR /workspace
EXPOSE 30141 22 5900 6080
